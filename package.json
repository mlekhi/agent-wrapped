{
  "name": "agent-wrapped",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "local-only coding agent usage summaries",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agent-wrapped": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "dist/assets",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "prepare": "npm run build",
    "test": "npm run build && node --test \"dist/test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2"
  }
}
